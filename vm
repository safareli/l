#!/bin/bash
set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
CONFIG="$SCRIPT_DIR/colima.yaml"
PROFILE="${L_COLIMA_PROFILE:-l}"
PROFILE_DIR="$HOME/.colima/$PROFILE"
PROFILE_CONFIG="$PROFILE_DIR/colima.yaml"

case "$1" in
  ssh)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm ssh"
      exit 1
    fi
    SSH_HOST="colima-$PROFILE"
    ssh "$SSH_HOST"
    ;;
  config)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm config"
      exit 1
    fi
    echo "=== CONFIG ==="
    mkdir -p "$PROFILE_DIR"
    if [[ -e "$PROFILE_CONFIG" ]]; then
      git --no-pager diff --no-index -b "$PROFILE_CONFIG" "$CONFIG" || true
      read -p "Config '$PROFILE_CONFIG' already exists. Overwrite? [y/N] " confirm
      if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 1
      fi
    fi
    cp "$CONFIG" "$PROFILE_CONFIG"
    echo "Config copied to $PROFILE_CONFIG"
    ;;
  setup)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm setup"
      exit 1
    fi
    echo "=== SETUP VM ==="
    "$0" down
    "$0" config
    "$0" up
    "$0" provision
    ;;
  up)
    FORCE=false
    if [[ "$2" == "-f" || "$2" == "--force" ]]; then
      FORCE=true
    elif [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm up [-f|--force]"
      exit 1
    fi
    echo "=== STARTING VM ==="
    if [[ -x "$SCRIPT_DIR/hook_pre_up.sh" ]]; then
      echo "=== Running pre-up hook ==="
      "$SCRIPT_DIR/hook_pre_up.sh"
    fi
    LIMA_DIR="$HOME/.colima/_lima"
    if $FORCE; then
      # Remove stale disk locks left behind by unclean shutdown
      for lock in "$LIMA_DIR"/_disks/*/in_use_by; do
        if [[ -L "$lock" ]]; then
          echo "Removing stale disk lock: $lock"
          rm "$lock"
        fi
      done
    fi
    if ! colima start --profile "$PROFILE"; then
      # Check if failure is due to stale disk locks
      for lock in "$LIMA_DIR"/_disks/*/in_use_by; do
        if [[ -L "$lock" ]]; then
          echo ""
          echo "Found stale disk lock: $lock"
          echo "This can happen after an unclean shutdown (e.g. battery death)."
          echo "Run 'vm up -f' to clear stale locks and retry. Also maybe try 'vm down [-f]' first"
          exit 1
        fi
      done
      exit 1
    fi
    echo "=== Configuring /etc/hosts ==="
    ssh "colima-$PROFILE" "sudo bash -s" <<'HOSTS_EOF'
      grep -qF 'console.neon.tech' /etc/hosts || echo '192.168.5.2 console.neon.tech' >> /etc/hosts
      grep -qF 'api.github.com' /etc/hosts || echo '192.168.5.2 api.github.com' >> /etc/hosts
HOSTS_EOF
    ;;
  down)
    echo "=== STOPPING VM ==="
    STOP_ARGS=(--profile "$PROFILE")
    if [[ "$2" == "-f" || "$2" == "--force" ]]; then
      STOP_ARGS+=(--force)
    elif [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm down [-f|--force]"
      exit 1
    fi
    colima stop "${STOP_ARGS[@]}"
    if [[ -x "$SCRIPT_DIR/hook_post_down.sh" ]]; then
      echo "=== Running post-down hook ==="
      "$SCRIPT_DIR/hook_post_down.sh"
    fi
    ;;
  health)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm health"
      exit 1
    fi
    echo "=== HEALTH CHECK ==="
    echo "=== VM Status (profile: $PROFILE) ==="
    colima status --profile "$PROFILE" 2>&1
    echo ""
    echo "=== VM IP ==="
    VM_IP=$(colima list --profile "$PROFILE" --json | grep -o '"address":"[^"]*"' | cut -d'"' -f4)
    if [[ -n "$VM_IP" ]]; then
      echo "IP: $VM_IP"
    else
      echo "IP: not assigned (enable network.address in colima.yaml)"
    fi
    echo ""
    echo "=== mDNS (Avahi) ==="
    if ping -c 1 -t 2 l.local &>/dev/null; then
      MDNS_IP=$(ping -c 1 l.local 2>/dev/null | head -1 | grep -o '([^)]*)'| tr -d '()')
      echo "l.local: $MDNS_IP"
    else
      echo "l.local: not resolving"
    fi
    echo ""
    echo "=== Docker Contexts (* = active) ==="
    docker context ls
    CONTEXT_NAME="colima-$PROFILE"
    if ! docker context ls --format '{{.Name}}' | grep -q "^${CONTEXT_NAME}$"; then
      echo ""
      echo "Context '$CONTEXT_NAME' does not exist."
    elif ! docker context ls --format '{{.Current}} {{.Name}}' | grep -q "^true ${CONTEXT_NAME}$"; then
      echo ""
      echo "To switch to this profile's context run:"
      echo "  docker context use $CONTEXT_NAME"
    fi
    echo ""
    echo "=== VM Network ==="
    if ssh "colima-$PROFILE" "wget -q --spider https://nixos.org" 2>/dev/null; then
      echo "DNS: ready"
    else
      echo "DNS: not ready"
    fi
    ;;
  rm)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm rm"
      exit 1
    fi
    echo "=== REMOVING VM ==="
    read -p "Delete VM profile '$PROFILE'? This will destroy all data. [y/N] " confirm
    if [[ "$confirm" =~ ^[Yy]$ ]]; then
      colima delete --profile "$PROFILE" --force
    else
      echo "Aborted."
    fi
    ;;
  provision)
    if [[ -n "$2" ]]; then
      echo "Unknown option: $2"
      echo "Usage: vm provision"
      exit 1
    fi
    echo "=== PROVISIONING VM ==="
    SSH_HOST="colima-$PROFILE"

    # System provisioning (as root)
    ssh "$SSH_HOST" "sudo bash -s" <<'SYSTEM_EOF'
      set -e
      [ -f /etc/provision-system-done ] && echo "System already provisioned" && exit 0

      echo "==> Installing Tailscale..."
      if ! command -v tailscale &> /dev/null; then
        wget -qO- https://tailscale.com/install.sh | sh
      fi

      echo "==> Installing Nix dependencies..."
      apt-get update && apt-get install -y xz-utils

      echo "==> Installing Nix..."
      if [ ! -d /nix ]; then
        wget -O /tmp/nix-install.sh https://nixos.org/nix/install
        sh /tmp/nix-install.sh --daemon --yes
        rm /tmp/nix-install.sh
      fi

      echo "==> Enabling Nix experimental features..."
      if ! grep -q "experimental-features" /etc/nix/nix.conf 2>/dev/null; then
        echo "experimental-features = fetch-tree nix-command flakes" >> /etc/nix/nix.conf
        systemctl restart nix-daemon
      fi

      echo "==> Installing and configuring Avahi (mDNS)..."
      apt-get install -y avahi-daemon
      cat > /etc/avahi/avahi-daemon.conf <<'AVAHI_CONF'
[server]
host-name=l
domain-name=local
use-ipv4=yes
use-ipv6=yes
allow-interfaces=eth0

[publish]
publish-addresses=yes
publish-hinfo=no
publish-workstation=no

[reflector]

[rlimits]
AVAHI_CONF
      systemctl enable avahi-daemon
      systemctl restart avahi-daemon

      touch /etc/provision-system-done
      echo "==> System provisioning complete"
SYSTEM_EOF

    # User provisioning
    ssh "$SSH_HOST" "bash -s" <<'USER_EOF'
      set -e
      [ -f ~/.provision-user-done ] && echo "User already provisioned" && exit 0

      echo "==> Sourcing Nix..."
      if [ -f /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
        . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
      fi

      echo "==> Setting up home-manager config..."
      if [ ! -d ~/.config/home-manager ]; then
        mkdir -p ~/.config
        git clone https://github.com/safareli/l.git ~/.config/home-manager
      fi

      echo "==> Running home-manager switch..."
      nix run home-manager/master -- switch -b bak --flake ~/.config/home-manager

      echo "==> Setting zsh as default shell..."
      sudo chsh -s "$(which zsh)" "$USER"

      echo "==> Enabling linger for user services..."
      sudo loginctl enable-linger "$USER"

      touch ~/.provision-user-done
      echo "==> User provisioning complete"
USER_EOF
    "$0" down
    "$0" up
    "$0" health
    ;;
  chrome)
    TMUX_SESSION="chrome-agent"
    case "$2" in
      up)
        echo "=== STARTING CHROME ==="
        CHROME_PROFILE_DIR="$SCRIPT_DIR/.chrome-profile"
        mkdir -p "$CHROME_PROFILE_DIR/Default"
        # Pre-seed a distinctive orange toolbar color so this instance is visually different
        if [[ ! -f "$CHROME_PROFILE_DIR/Default/Preferences" ]]; then
          cat > "$CHROME_PROFILE_DIR/Default/Preferences" <<'PREFS_EOF'
{
  "browser": {
    "theme": {
      "color_scheme": 0,
      "user_color": -48896
    }
  }
}
PREFS_EOF
        fi
        if tmux has-session -t "$TMUX_SESSION" 2>/dev/null; then
          echo "Chrome already running in tmux session '$TMUX_SESSION'"
        else
          tmux new-session -d -s "$TMUX_SESSION" \
            "'/Applications/Google Chrome.app/Contents/MacOS/Google Chrome' --remote-debugging-port=9222 --user-data-dir='$CHROME_PROFILE_DIR'"
          echo "Chrome started in tmux session '$TMUX_SESSION'"
        fi
        echo "=== WAITING FOR CHROME ==="
        for i in $(seq 1 30); do
          if curl -s -o /dev/null http://localhost:9222/json/version; then
            break
          fi
          if [ "$i" -eq 30 ]; then
            echo "Chrome failed to start within 30s"
            exit 1
          fi
          sleep 1
        done
        echo "=== CONNECTING AGENT BROWSER ==="
        ssh -t -o LogLevel=QUIET "colima-$PROFILE" '$HOME/.npm-global/bin/agent-browser connect "http://192.168.5.2:9222"'
        ;;
      down)
        echo "=== STOPPING CHROME ==="
        tmux kill-session -t "$TMUX_SESSION" 2>/dev/null && echo "Chrome stopped" || echo "No chrome session running"
        ;;
      *)
        echo "Usage: vm chrome [up|down]"
        exit 1
        ;;
    esac
    ;;
  *)
    echo "Usage: vm [setup|config|up|down|health|rm|provision|ssh|chrome]"
    exit 1
    ;;
esac
