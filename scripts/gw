#!/usr/bin/env bash
set -euo pipefail

GW_OVERLAY_DIR="${HOME}/.local/share/gw/overlays"
GW_SYSTEMD_DIR="${HOME}/.config/systemd/user"

show_help() {
    cat << 'EOF'
Git worktree manager (sibling worktrees only)

Usage:
  gw new <name>           Create new worktree from main
  gw fork <name>          Create new worktree from current HEAD
  gw delete [name]        Delete current worktree (or named one)
  gw list                 List all worktrees
  gw install              Overlay-aware dependency install (pnpm)
  gw init-golden          Set up current repo as overlay golden
  gw update-golden        Update golden to latest origin/main
  gw shell-hook <shell>   Print shell wrapper (add to .zshrc/.bashrc)
  gw help                 Show this help

Aliases:
  n=new, f=fork, d=delete, l=list, i=install, ig=init-golden, ug=update-golden, h=help

Shell integration:
  eval "$(gw shell-hook zsh)"    # add to .zshrc
  eval "$(gw shell-hook bash)"   # add to .bashrc

When the base repo is initialized as golden (gw.golden=true in git config),
new/fork use fuse-overlayfs for instant (~25ms) worktree creation with zero
disk overhead. Mounts persist across reboots via systemd user services.

Environment:
  GW_USER            Username prefix for new branches (default: $USER)
  GW_EVAL_FILE       If set, gw writes shell commands for the wrapper to eval
  GW_CACHE_STRATEGY  How to invalidate FUSE cache after gw install:
                       drop_caches — sudo echo 2 > /proc/sys/vm/drop_caches
                       remount     — lazy unmount + remount (breaks dev servers)
                       auto        — drop_caches if passwordless sudo, else remount
                     (default: auto)

Examples:
  gw init-golden                     # one-time setup
  gw new feature-auth                # overlay if golden, normal otherwise
  gw fork split-current-task
  gw install                         # overlay-aware pnpm install
  gw delete
  gw update-golden                   # fetch main, reinstall deps
EOF
}

# ── Helpers ──────────────────────────────────────────────────────────

signal_eval() {
    if [ -n "${GW_EVAL_FILE:-}" ]; then
        printf '%s\n' "$1" >> "$GW_EVAL_FILE"
    else
        eval "$1"
    fi
}

signal_cd() {
    if [ -n "${GW_EVAL_FILE:-}" ]; then
        signal_eval "cd $(printf '%q' "$1")"
    else
        echo "  cd $1"
    fi
}


is_main_worktree() {
    local git_root
    git_root=$(git rev-parse --show-toplevel)
    # Main worktree has .git as a directory; linked worktrees have .git as a file
    [ -d "$git_root/.git" ]
}

resolve_golden() {
    local git_root
    git_root=$(git rev-parse --show-toplevel)
    local git_common_dir
    git_common_dir=$(cd "$git_root" && git rev-parse --git-common-dir)
    # git-common-dir may be relative to git_root; resolve to absolute
    if [[ "$git_common_dir" != /* ]]; then
        git_common_dir="${git_root}/${git_common_dir}"
    fi
    dirname "$git_common_dir"
}

is_golden() {
    local base_dir="$1"
    [ "$(git -C "$base_dir" config --local --get gw.golden 2>/dev/null)" = "true" ]
}

overlay_dirs() {
    local worktree_path="$1"
    local repo_id
    repo_id=$(basename "$(dirname "$worktree_path")")-$(basename "$worktree_path")
    echo "${GW_OVERLAY_DIR}/${repo_id}"
}

overlay_service_name() {
    local worktree_path="$1"
    local repo_id
    repo_id=$(basename "$(dirname "$worktree_path")")-$(basename "$worktree_path")
    echo "gw-overlay-${repo_id}"
}

is_overlay_mounted() {
    local path="$1"
    mount | grep -q "fuse-overlayfs on ${path} "
}

run_install_quiet() {
    local worktree_path="$1"
    local manager="$2"
    shift 2

    if ! command -v "$manager" >/dev/null 2>&1; then
        echo "Deps: $manager not found, skipped"
        return 0
    fi

    local log_file
    log_file=$(mktemp -t "gw-${manager}-install-XXXXXX.log")

    if (cd "$worktree_path" && "$@") >"$log_file" 2>&1; then
        rm -f "$log_file"
        echo "Deps: $manager install done"
    else
        echo "Deps: $manager install failed (log: $log_file)"
        tail -n 40 "$log_file" || true
        return 1
    fi
}

run_deps_install() {
    local worktree_path="$1"
    if [ -f "$worktree_path/pnpm-lock.yaml" ]; then
        run_install_quiet "$worktree_path" "pnpm" pnpm install
    elif [ -f "$worktree_path/bun.lockb" ] || [ -f "$worktree_path/bun.lock" ]; then
        run_install_quiet "$worktree_path" "bun" bun install
    elif [ -f "$worktree_path/package-lock.json" ]; then
        run_install_quiet "$worktree_path" "npm" npm install
    fi
}

# ── Overlay systemd helpers ──────────────────────────────────────────

overlay_start_mount() {
    local golden_dir="$1"
    local worktree_path="$2"

    local overlay_base
    overlay_base=$(overlay_dirs "$worktree_path")
    local upper="${overlay_base}/upper"
    local work="${overlay_base}/work"
    local pnpm_install="${overlay_base}/pnpm-install"

    # lowerdir order: left = highest priority among lowers
    # pnpm-install overrides golden, upper overrides everything
    local lowerdirs="${pnpm_install}:${golden_dir}"

    # Mount immediately (fast, ~3ms)
    # allow_other lets Docker daemon (root) access the mount
    fuse-overlayfs \
        -o "lowerdir=${lowerdirs},upperdir=${upper},workdir=${work},allow_other" \
        "$worktree_path"

    # Create systemd service for persistence across reboots (async-safe)
    local service_name
    service_name=$(overlay_service_name "$worktree_path")
    local fuse_bin
    fuse_bin=$(command -v fuse-overlayfs)
    local fusermount_bin
    fusermount_bin=$(command -v fusermount3)

    mkdir -p "$GW_SYSTEMD_DIR"
    cat > "${GW_SYSTEMD_DIR}/${service_name}.service" << EOF
[Unit]
Description=gw overlay: $(basename "$worktree_path")

[Service]
Type=forking
ExecStart=${fuse_bin} -o lowerdir=${lowerdirs},upperdir=${upper},workdir=${work},allow_other ${worktree_path}
ExecStop=${fusermount_bin} -u ${worktree_path}

[Install]
WantedBy=default.target
EOF

    # Enable for boot (don't start — already mounted). Run in background.
    (systemctl --user daemon-reload && systemctl --user enable "$service_name" --quiet) &
}

overlay_stop_mount() {
    local worktree_path="$1"

    local service_name
    service_name=$(overlay_service_name "$worktree_path")

    systemctl --user disable --now "$service_name" --quiet 2>/dev/null || true
    rm -f "${GW_SYSTEMD_DIR}/${service_name}.service"
    systemctl --user daemon-reload
}

# ── Overlay helpers ──────────────────────────────────────────────────

overlay_create() {
    local golden_dir="$1"
    local worktree_path="$2"
    local branch_name="$3"

    local overlay_base
    overlay_base=$(overlay_dirs "$worktree_path")
    local upper="${overlay_base}/upper"
    local work="${overlay_base}/work"

    # 1. Create worktree with --no-checkout --detach (just the .git link, ~6ms)
    git worktree add --no-checkout --detach "$worktree_path" HEAD 2>/dev/null

    # 2. Read the .git link file content before we remove the dir
    local git_link
    git_link=$(cat "$worktree_path/.git")

    # 3. Figure out the worktree git dir (where the index lives)
    local wt_git_dir="${git_link#gitdir: }"

    # 4. Copy golden's index to worktree index for instant git status
    cp "${golden_dir}/.git/index" "${wt_git_dir}/index"

    # 5. Set core.checkStat=minimal (overlay changes device numbers)
    git -C "$worktree_path" config extensions.worktreeConfig true
    git -C "$worktree_path" config --worktree core.checkStat minimal

    # 6. Remove the empty checkout dir, recreate as mountpoint
    local pnpm_install="${overlay_base}/pnpm-install"
    rm -rf "$worktree_path"
    mkdir -p "$worktree_path" "$upper" "$work" "$pnpm_install"

    # 7. Write .git link into upper so it appears in the overlay
    echo "$git_link" > "$upper/.git"

    # 8. Mount overlay via systemd (persists across reboots)
    overlay_start_mount "$golden_dir" "$worktree_path"

    # 9. Checkout the branch
    (cd "$worktree_path" && git checkout "$branch_name" 2>/dev/null)
}

overlay_destroy() {
    local worktree_path="$1"

    local overlay_base
    overlay_base=$(overlay_dirs "$worktree_path")
    local golden_dir
    golden_dir=$(resolve_golden)

    # Disable systemd service (safe to do inline)
    overlay_stop_mount "$worktree_path"

    # FUSE cleanup must run in parent shell AFTER cd moves cwd away from mount
    signal_eval "\
fusermount3 -uz $(printf '%q' "$worktree_path") 2>/dev/null || true
rmdir $(printf '%q' "$worktree_path") 2>/dev/null || true
rm -rf $(printf '%q' "$overlay_base")
git -C $(printf '%q' "$golden_dir") worktree prune 2>/dev/null || true"
}

# ── Overlay install helpers ───────────────────────────────────────────

golden_node_modules_dirs() {
    # Find top-level node_modules dirs in golden (not nested inside other node_modules)
    local golden_dir="$1"
    find "$golden_dir" -name node_modules -not -path '*/node_modules/*' -type d 2>/dev/null
}

ensure_opaque_markers() {
    # Sync opaque markers in target layer to match golden's node_modules dirs.
    # Removes stale markers (from node_modules dirs golden no longer has),
    # creates missing ones. Equivalent to a full wipe + recreate but only
    # touches the marker files.
    local golden_dir="$1"
    local target_dir="$2"

    # Remove all existing opaque markers
    find "$target_dir" -name '.wh..wh..opq' -delete 2>/dev/null || true

    # Create markers for current golden node_modules dirs
    while IFS= read -r nm_dir; do
        local rel_path="${nm_dir#"$golden_dir"/}"
        mkdir -p "${target_dir}/${rel_path}"
        touch "${target_dir}/${rel_path}/.wh..wh..opq"
    done < <(golden_node_modules_dirs "$golden_dir")
}

cmd_install() {
    local git_root
    git_root=$(git rev-parse --show-toplevel)

    if ! is_overlay_mounted "$git_root"; then
        echo "Not an overlay worktree. Running normal install..."
        run_deps_install "$git_root"
        return
    fi

    local golden_dir
    golden_dir=$(resolve_golden)

    if ! is_golden "$golden_dir"; then
        echo "Error: Golden repo not found at $golden_dir"
        exit 1
    fi

    # Only pnpm is supported for overlay install
    if [ ! -f "$git_root/pnpm-lock.yaml" ]; then
        echo "Error: gw install only supports pnpm (no pnpm-lock.yaml found)"
        echo "For other package managers, run install directly."
        exit 1
    fi

    if ! command -v pnpm >/dev/null 2>&1; then
        echo "Error: pnpm not found"
        exit 1
    fi

    # Verify golden and overlay dirs are on the same device (for hardlinks)
    local overlay_base
    overlay_base=$(overlay_dirs "$git_root")
    local golden_dev
    golden_dev=$(stat -c %d "$golden_dir")
    local overlay_dev
    overlay_dev=$(stat -c %d "$overlay_base")
    if [ "$golden_dev" != "$overlay_dev" ]; then
        echo "Error: Golden ($golden_dir) and overlay storage ($overlay_base) are on different filesystems."
        echo "Hardlinks won't work across filesystem boundaries."
        exit 1
    fi

    local upper="${overlay_base}/upper"
    local pnpm_install="${overlay_base}/pnpm-install"

    # Detect cold vs hot: pnpm-install layer has content?
    local is_cold=true
    if [ -n "$(ls -A "$pnpm_install" 2>/dev/null)" ]; then
        is_cold=false
    fi

    if [ "$is_cold" = true ]; then
        echo "First install (cold path)..."

        # Step 1: Clean upper layer's node_modules
        echo "  Cleaning upper node_modules..."
        # Remove actual node_modules dirs from upper
        find "$upper" -name node_modules -not -path '*/node_modules/*' -type d -exec rm -rf {} + 2>/dev/null || true
        # Remove whiteout files for node_modules from upper
        find "$upper" -name '.wh.node_modules' -exec rm -f {} + 2>/dev/null || true

        # Step 2: Hardlink golden's node_modules → pnpm-install layer + add opaque markers
        echo "  Hardlinking golden node_modules..."
        while IFS= read -r nm_dir; do
            local rel_path="${nm_dir#"$golden_dir"/}"
            local parent_rel
            parent_rel=$(dirname "$rel_path")
            mkdir -p "${pnpm_install}/${parent_rel}"
            cp -al "$nm_dir" "${pnpm_install}/${rel_path}"
            touch "${pnpm_install}/${rel_path}/.wh..wh..opq"
        done < <(golden_node_modules_dirs "$golden_dir")
    else
        echo "Subsequent install (hot path)..."
    fi

    # Common steps (both cold and hot)

    # Copy package files → pnpm-install layer.
    # Cold path: read from golden (overlay FUSE daemon has stale cache after
    # layer modifications in cold steps 1-2).
    # Hot path: read from overlay BEFORE modifying pnpm-install (once we
    # write to pnpm-install, the FUSE daemon's cached view becomes stale).
    # Stage everything to a temp dir first, then move into pnpm-install.
    local src_root="$git_root"
    if [ "$is_cold" = true ]; then
        src_root="$golden_dir"
    fi

    echo "  Syncing package files..."
    local stage_dir
    stage_dir=$(mktemp -d -t "gw-stage-XXXXXX")
    trap "rm -rf '$stage_dir'" EXIT

    for f in package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc; do
        if [ -f "$src_root/$f" ]; then
            cp "$src_root/$f" "$stage_dir/$f"
        fi
    done

    # Copy patches dir (pnpm resolves patch paths relative to project root)
    if [ -d "$src_root/patches" ]; then
        cp -r "$src_root/patches" "$stage_dir/patches"
    fi

    # Copy workspace package.json files
    if [ -f "$src_root/pnpm-workspace.yaml" ]; then
        # Parse workspace packages from pnpm-workspace.yaml
        # Look for lines like "  - 'packages/*'" or "  - packages/*"
        local workspace_globs
        workspace_globs=$(sed -n '/^packages:/,/^[^ ]/{ /^  *- /{ s/^  *- *//; s/['\''"]//g; p; } }' "$src_root/pnpm-workspace.yaml")

        while IFS= read -r glob; do
            [ -z "$glob" ] && continue
            # Expand glob against the source root
            for pkg_dir in $src_root/$glob; do
                [ -d "$pkg_dir" ] || continue
                if [ -f "$pkg_dir/package.json" ]; then
                    local rel_pkg="${pkg_dir#"$src_root"/}"
                    mkdir -p "${stage_dir}/${rel_pkg}"
                    cp "$pkg_dir/package.json" "${stage_dir}/${rel_pkg}/package.json"
                fi
            done
        done <<< "$workspace_globs"
    fi

    # Now move staged files into pnpm-install layer
    for f in package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc; do
        [ -f "$stage_dir/$f" ] && mv "$stage_dir/$f" "$pnpm_install/$f"
    done
    if [ -d "$stage_dir/patches" ]; then
        rm -rf "$pnpm_install/patches"
        mv "$stage_dir/patches" "$pnpm_install/patches"
    fi
    # Move workspace package.json files
    find "$stage_dir" -name package.json -not -path "$stage_dir/package.json" 2>/dev/null | while IFS= read -r staged_pkg; do
        local rel="${staged_pkg#"$stage_dir"/}"
        mkdir -p "$(dirname "$pnpm_install/$rel")"
        mv "$staged_pkg" "$pnpm_install/$rel"
    done
    rm -rf "$stage_dir"
    trap - EXIT

    # Run pnpm install in pnpm-install layer (real fs — hardlinks work)
    echo "  Running pnpm install (in pnpm-install layer)..."
    local log_file
    log_file=$(mktemp -t "gw-pnpm-install-XXXXXX.log")

    if (cd "$pnpm_install" && pnpm install --ignore-scripts) >"$log_file" 2>&1; then
        rm -f "$log_file"
        echo "  pnpm install done"
    else
        echo "  pnpm install failed (log: $log_file)"
        tail -n 40 "$log_file" || true
        return 1
    fi

    # Resolve cache invalidation strategy
    local strategy="${GW_CACHE_STRATEGY:-auto}"
    if [ "$strategy" = "auto" ]; then
        if sudo -n true 2>/dev/null; then
            strategy="drop_caches"
        else
            strategy="remount"
        fi
    fi

    # Invalidate fuse-overlayfs's cached lookups. fuse-overlayfs caches
    # lower-layer entries internally; the kernel dentry/inode cache is what
    # keeps the FUSE daemon from being re-queried. Dropping it forces the
    # kernel to re-ask fuse-overlayfs, which then re-reads from disk.
    case "$strategy" in
        drop_caches)
            echo "  Dropping kernel dentry cache..."
            echo 2 | sudo tee /proc/sys/vm/drop_caches > /dev/null
            ;;
        remount)
            echo "  Remounting overlay (lazy)..."
            cd /
            fusermount3 -uz "$git_root"
            overlay_start_mount "$golden_dir" "$git_root"
            cd "$git_root"
            ;;
        *)
            echo "Error: Unknown GW_CACHE_STRATEGY '$strategy' (use: drop_caches, remount, auto)"
            exit 1
            ;;
    esac

    # Run pnpm rebuild --pending in the overlay worktree (full source tree visible)
    # --pending only rebuilds packages installed with --ignore-scripts above,
    # skipping golden's pre-built native modules (esbuild, swc, etc.)
    echo "  Running pnpm rebuild --pending (in worktree)..."
    log_file=$(mktemp -t "gw-pnpm-rebuild-XXXXXX.log")

    if (cd "$git_root" && pnpm rebuild --pending) >"$log_file" 2>&1; then
        rm -f "$log_file"
        echo "  pnpm rebuild --pending done"
    else
        echo "  pnpm rebuild --pending failed (log: $log_file)"
        tail -n 40 "$log_file" || true
        return 1
    fi

    if [ "$strategy" = "remount" ]; then
        signal_cd "$git_root"
        echo "⚠ Overlay was remounted. Restart any running dev servers in this worktree."
    fi

    echo "Install complete."
}

# ── Commands ─────────────────────────────────────────────────────────

cmd_create_from_base() {
    local base_ref="$1"
    local mode_name="$2"
    shift 2

    local name="${1:-}"

    if [ -z "$name" ]; then
        echo "Error: Branch name required"
        echo "Usage: gw ${mode_name} <name>"
        exit 1
    fi

    if [ "$#" -gt 1 ]; then
        echo "Error: gw ${mode_name} accepts only one argument"
        echo "Usage: gw ${mode_name} <name>"
        exit 1
    fi

    local base_dir
    base_dir=$(resolve_golden)

    local base_name
    base_name=$(basename "$base_dir")

    local parent_dir
    parent_dir=$(dirname "$base_dir")

    local branch_name
    local is_existing_local=false
    local is_existing_remote=false

    if git show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
        branch_name="$name"
        is_existing_local=true
    elif git show-ref --verify --quiet "refs/remotes/origin/$name" 2>/dev/null; then
        branch_name="$name"
        is_existing_remote=true
    else
        branch_name="${GW_USER:-$USER}/$(date +%Y-%m-%d)-$name"
    fi

    local safe_branch_name="${branch_name//\//-}"
    local worktree_path="${parent_dir}/${base_name}--${safe_branch_name}"

    if [ -d "$worktree_path" ]; then
        echo "Error: Directory already exists: $worktree_path"
        exit 1
    fi

    # ── Ensure branch exists locally ────────────────────────────
    if [ "$is_existing_remote" = true ] && [ "$is_existing_local" = false ]; then
        git branch "$branch_name" "origin/$branch_name"
    elif [ "$is_existing_local" = false ] && [ "$is_existing_remote" = false ]; then
        git branch "$branch_name" "$base_ref"
    fi

    # ── Create worktree ──────────────────────────────────────────
    if is_golden "$base_dir"; then
        echo "Creating overlay worktree..."
        overlay_create "$base_dir" "$worktree_path" "$branch_name"
    else
        echo "Creating worktree..."
        git worktree add "$worktree_path" "$branch_name"
        run_deps_install "$worktree_path"
    fi

    # ── Common post-setup (works for both overlay and normal) ────
    if command -v direnv >/dev/null 2>&1; then
        direnv allow "$worktree_path" >/dev/null 2>&1 || true
    fi

    if [ -f "$base_dir/.env" ]; then
        cp "$base_dir/.env" "$worktree_path/.env"
        sed -i '/^BRANCH_HASH=/d' "$worktree_path/.env"

        local branch_hash
        branch_hash=$(printf '%s' "$branch_name" | md5sum | cut -c1-8)

        {
            echo ""
            echo "# Auto-generated for worktree isolation"
            echo "BRANCH_HASH=${branch_hash}"
        } >> "$worktree_path/.env"
    fi

    if [ -d "$base_dir/.pi" ] && [ ! -d "$worktree_path/.pi" ]; then
        cp -r "$base_dir/.pi" "$worktree_path/.pi"
    fi

    echo "Worktree ready: $worktree_path"
    echo "Branch: $branch_name"

    signal_cd "$worktree_path"
}

cmd_new() {
    cmd_create_from_base "main" "new" "$@"
}

cmd_fork() {
    cmd_create_from_base "HEAD" "fork" "$@"
}

cmd_delete() {
    local name="${1:-}"

    local git_root
    git_root=$(git rev-parse --show-toplevel)

    local base_dir
    base_dir=$(resolve_golden)

    local base_name
    base_name=$(basename "$base_dir")

    local parent_dir
    parent_dir=$(dirname "$base_dir")

    local worktree_path

    if [ -z "$name" ]; then
        if is_main_worktree; then
            echo "Error: Cannot delete main worktree. Use 'gw delete <name>' to delete a specific worktree."
            exit 1
        fi
        worktree_path="$git_root"
    else
        # Try direct dir name, then slash→dash (branch name), then branch lookup
        local safe_name="${name//\//-}"
        worktree_path="$parent_dir/${base_name}--${safe_name}"

        if [ ! -d "$worktree_path" ]; then
            # Search by branch name across all worktrees
            local found=""
            while IFS= read -r line; do
                if [[ "$line" == "worktree "* ]]; then
                    local wt="${line#worktree }"
                elif [[ "$line" == "branch refs/heads/"* ]]; then
                    local br="${line#branch refs/heads/}"
                    if [[ "$br" == "$name" ]]; then
                        found="$wt"
                        break
                    fi
                fi
            done < <(git worktree list --porcelain)

            if [ -n "$found" ]; then
                worktree_path="$found"
            else
                echo "Error: Worktree '$name' not found"
                echo "Available worktrees:"
                local _n="" _printed=false
                git worktree list --porcelain | while IFS= read -r line; do
                    if [[ "$line" == "worktree "* ]]; then
                        _n=$(basename "${line#worktree }")
                        _printed=false
                    elif [[ "$line" == "branch refs/heads/"* ]]; then
                        printf "  %-40s %s\n" "$_n" "[${line#branch refs/heads/}]"
                        _printed=true
                    elif [[ "$line" == "" ]] && [ "$_printed" = false ] && [ -n "$_n" ]; then
                        printf "  %-40s %s\n" "$_n" "(detached)"
                    fi
                done
                exit 1
            fi
        fi
    fi

    if [ -d "$worktree_path/.git" ]; then
        echo "Error: Cannot delete main worktree"
        exit 1
    fi

    echo "Deleting worktree: $worktree_path"

    local changes
    changes=$(cd "$worktree_path" && git status --porcelain 2>/dev/null || true)
    if [ -n "$changes" ]; then
        echo "⚠ WARNING: Worktree has uncommitted changes:"
        echo "$changes" | head -20
        echo ""
    fi

    read -r -p "Are you sure? (y/N) " -n 1
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted"
        exit 1
    fi

    local cd_target
    cd_target="$base_dir"

    # Signal cd BEFORE cleanup so parent shell moves away from mount first
    if [ "$worktree_path" = "$git_root" ]; then
        signal_cd "$cd_target"
    fi

    # Overlay or normal teardown
    if is_overlay_mounted "$worktree_path"; then
        overlay_destroy "$worktree_path"
    else
        git worktree remove "$worktree_path" --force
    fi

    echo "Worktree deleted"
}

cmd_list() {
    local base_dir
    base_dir=$(resolve_golden)
    local base_name
    base_name=$(basename "$base_dir")

    echo "Worktrees:"
    echo ""

    git worktree list --porcelain | while IFS= read -r line; do
        if [[ "$line" == "worktree "* ]]; then
            local wt_path="${line#worktree }"
            local wt_name
            wt_name=$(basename "$wt_path")
            local mode="normal"
            local upper_size="-"

            if is_overlay_mounted "$wt_path"; then
                mode="overlay"
                local overlay_base
                overlay_base=$(overlay_dirs "$wt_path")
                if [ -d "${overlay_base}/upper" ]; then
                    upper_size=$(du -sh "${overlay_base}/upper" 2>/dev/null | cut -f1)
                fi
            fi

            local branch_info=""
            local dirty=""

            branch_info=$(cd "$wt_path" 2>/dev/null && git branch --show-current 2>/dev/null || echo "(detached)")

            if [ -d "$wt_path" ]; then
                local changes
                changes=$(cd "$wt_path" 2>/dev/null && git status --porcelain 2>/dev/null | head -1 || true)
                if [ -n "$changes" ]; then
                    dirty=" [dirty]"
                fi
            fi

            if is_golden "$base_dir" && [[ "$wt_name" == "$base_name" ]]; then
                printf "  %-40s %-20s %s\n" "$wt_name" "[golden]" "$branch_info"
            elif [ "$mode" = "overlay" ]; then
                printf "  %-40s %-20s %s%s\n" "$wt_name" "[overlay: ${upper_size}]" "$branch_info" "$dirty"
            else
                printf "  %-40s %-20s %s%s\n" "$wt_name" "" "$branch_info" "$dirty"
            fi
        fi
    done
}

cmd_init_golden() {
    local git_root
    git_root=$(git rev-parse --show-toplevel)
    local current_dir
    current_dir=$(basename "$git_root")

    if [[ "$current_dir" == *"--"* ]]; then
        echo "Error: Run init-golden from the base repo, not a worktree"
        exit 1
    fi

    if [ "$(git -C "$git_root" config --local --get gw.golden 2>/dev/null)" = "true" ]; then
        echo "Already a golden repo: $git_root"
        exit 0
    fi

    echo "Initializing golden repo: $git_root"

    # Ensure lingering is enabled for persistent systemd user services
    if ! loginctl show-user "$USER" --property=Linger 2>/dev/null | grep -q "yes"; then
        echo "Enabling lingering for systemd user services..."
        loginctl enable-linger "$USER" 2>/dev/null || \
            echo "⚠ Could not enable lingering. Overlay mounts may not persist across reboots."
    fi

    # Detach HEAD so all branch names are free for worktrees
    local main_ref
    main_ref=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/||' || true)
    if [ -z "$main_ref" ]; then
        if git rev-parse --verify origin/main >/dev/null 2>&1; then
            main_ref="origin/main"
        elif git rev-parse --verify origin/master >/dev/null 2>&1; then
            main_ref="origin/master"
        else
            main_ref="HEAD"
        fi
    fi
    echo "Detaching HEAD at $main_ref..."
    git checkout --detach "$main_ref"

    echo "Installing dependencies..."
    run_deps_install "$git_root"

    git -C "$git_root" config --local gw.golden true

    echo ""
    echo "Golden ready! Worktrees created with 'gw new/fork' will now use overlayfs."
    echo "Never work directly in this directory — use worktrees."
}

cmd_update_golden() {
    local golden_dir
    golden_dir=$(resolve_golden)

    if ! is_golden "$golden_dir"; then
        echo "Error: Not a golden repo. Run 'gw init-golden' first."
        exit 1
    fi

    local base_name
    base_name=$(basename "$golden_dir")

    # 1. Fetch
    echo "Fetching origin..."
    (cd "$golden_dir" && git fetch origin)

    local main_ref
    main_ref=$(cd "$golden_dir" && git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/||' || true)
    if [ -z "$main_ref" ]; then
        if (cd "$golden_dir" && git rev-parse --verify origin/main >/dev/null 2>&1); then
            main_ref="origin/main"
        elif (cd "$golden_dir" && git rev-parse --verify origin/master >/dev/null 2>&1); then
            main_ref="origin/master"
        else
            echo "Error: No remote origin found. Cannot update golden."
            exit 1
        fi
    fi

    # 2. Early exit if nothing to update
    local new_head
    new_head=$(cd "$golden_dir" && git rev-parse "$main_ref")
    local old_head
    old_head=$(cd "$golden_dir" && git rev-parse HEAD)

    if [ "$new_head" = "$old_head" ]; then
        echo "Golden already up to date."
        return
    fi

    echo "$(cd "$golden_dir" && git log --oneline "$old_head".."$new_head" | wc -l) new commit(s)"

    # 3. Pre-check: collect dirty overlay worktrees
    local dirty_wts=()
    while IFS= read -r line; do
        if [[ "$line" == "worktree "* ]]; then
            local wt_path="${line#worktree }"
            [[ "$(basename "$wt_path")" == "$base_name" ]] && continue
            is_overlay_mounted "$wt_path" || continue

            local changes
            changes=$(cd "$wt_path" && git status --porcelain 2>/dev/null || true)
            if [ -n "$changes" ]; then
                echo "  DIRTY: $(basename "$wt_path")"
                echo "$changes" | head -5 | sed 's/^/    /'
                dirty_wts+=("$wt_path")
            fi
        fi
    done < <(git worktree list --porcelain)

    if [ "${#dirty_wts[@]}" -gt 0 ]; then
        echo ""
        read -r -p "Stash changes in ${#dirty_wts[@]} dirty worktree(s) and continue? (y/N) " -n 1
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Aborted. Commit or stash manually, then retry."
            exit 1
        fi

        for wt_path in "${dirty_wts[@]}"; do
            local wt_name
            wt_name=$(basename "$wt_path")
            echo "  Stashing: $wt_name"
            (cd "$wt_path" && git stash push -m "gw-update-golden:${wt_name}" --include-untracked --quiet)
        done
    fi

    # 4. Update golden
    echo "Updating golden..."
    (cd "$golden_dir" && git checkout --detach "$main_ref" --quiet)

    echo "Installing dependencies..."
    run_deps_install "$golden_dir"

    # 4b. Ensure opaque markers for worktrees that have run gw install
    while IFS= read -r line; do
        if [[ "$line" == "worktree "* ]]; then
            local wt_path="${line#worktree }"
            [[ "$(basename "$wt_path")" == "$base_name" ]] && continue
            is_overlay_mounted "$wt_path" || continue

            local wt_overlay_base
            wt_overlay_base=$(overlay_dirs "$wt_path")
            local wt_pnpm_install="${wt_overlay_base}/pnpm-install"

            if [ -d "$wt_pnpm_install" ] && [ -n "$(ls -A "$wt_pnpm_install" 2>/dev/null)" ]; then
                echo "  Syncing opaque markers: $(basename "$wt_path")"
                ensure_opaque_markers "$golden_dir" "$wt_pnpm_install"
            fi
        fi
    done < <(git worktree list --porcelain)

    # 5. Reset behind worktrees so they don't show phantom changes
    while IFS= read -r line; do
        if [[ "$line" == "worktree "* ]]; then
            local wt_path="${line#worktree }"
            [[ "$(basename "$wt_path")" == "$base_name" ]] && continue
            is_overlay_mounted "$wt_path" || continue

            local branch
            branch=$(cd "$wt_path" && git branch --show-current 2>/dev/null || echo "(detached)")

            if ! (cd "$wt_path" && git merge-base --is-ancestor "$new_head" HEAD 2>/dev/null); then
                echo "  Resetting: $(basename "$wt_path") ($branch)"
                (cd "$wt_path" && git reset --hard --quiet)
            fi
        fi
    done < <(git worktree list --porcelain)

    # 6. Pop named stashes (order-independent)
    for wt_path in "${dirty_wts[@]}"; do
        local wt_name
        wt_name=$(basename "$wt_path")
        local stash_ref
        stash_ref=$(cd "$wt_path" && git stash list | grep "gw-update-golden:${wt_name}$" | head -1 | cut -d: -f1)
        if [ -n "$stash_ref" ]; then
            echo "  Unstashing: $wt_name"
            if ! (cd "$wt_path" && git stash pop "$stash_ref" --quiet 2>/dev/null); then
                echo "    ⚠ Stash pop failed (conflicts?) — changes saved in: git stash show $stash_ref"
            fi
        fi
    done

    echo ""
    echo "Golden updated to $(echo "$new_head" | cut -c1-8)."
}

cmd_shell_hook() {
    local shell="${1:-}"
    local gw_bin
    gw_bin=$(command -v gw 2>/dev/null || echo "\$HOME/.local/bin/gw")

    case "$shell" in
        zsh|bash)
            cat << HOOK
gw() {
  local evalfile=\$(mktemp)
  trap "rm -f \$evalfile" EXIT
  GW_EVAL_FILE="\$evalfile" "$gw_bin" "\$@"
  local exit_code=\$?
  [ -s "\$evalfile" ] && source "\$evalfile"
  return \$exit_code
}
HOOK
            ;;
        "")
            echo "Usage: gw shell-hook <shell>"
            echo "Supported: zsh, bash"
            echo ""
            echo "Add to your rc file:"
            echo '  eval "$(gw shell-hook zsh)"    # .zshrc'
            echo '  eval "$(gw shell-hook bash)"   # .bashrc'
            exit 1
            ;;
        *)
            echo "Error: Unsupported shell '$shell'. Use 'zsh' or 'bash'."
            exit 1
            ;;
    esac
}

# ── Main dispatch ────────────────────────────────────────────────────

case "${1:-}" in
    n|new)
        shift
        cmd_new "$@"
        ;;
    f|fork)
        shift
        cmd_fork "$@"
        ;;
    d|delete|rm)
        shift
        cmd_delete "$@"
        ;;
    l|list|ls)
        shift || true
        cmd_list
        ;;
    i|install)
        shift
        cmd_install
        ;;
    ig|init-golden)
        shift
        cmd_init_golden
        ;;
    ug|update-golden)
        shift
        cmd_update_golden
        ;;
    shell-hook|sh)
        shift
        cmd_shell_hook "$@"
        ;;
    h|help|--help|-h)
        show_help
        ;;
    "")
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
